# Server-only — never prefix with NEXT_PUBLIC_
#
# Optional — canonical URL for sitemap, Open Graph, and robots (Week 3+)
# SITE_URL=https://your-production-domain.com
#
# v1: Optional — only needed if you enable form APIs in v1.1
# RATE_LIMIT_WINDOW_MS=900000
# RATE_LIMIT_MAX=10
# CONTACT_WEBHOOK_URL=

# Admin CMS — server-only bootstrap values. Credentials are stored in MongoDB after first login.
# MONGODB_URI=mongodb+srv://...
# MONGODB_DB_NAME=xone_cms
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=your-admin-password
# ADMIN_SESSION_TTL_DAYS=7
